# ============================================
# Frontend .gitignore
# ============================================

# Environment variables
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Node modules
node_modules/

# Temporary files
tempCodeRunnerFile.*
*.tmp

# Python
__pycache__/
*.pyc
venv/